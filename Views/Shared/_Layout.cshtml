<!DOCTYPE html>
<html lang="es">
    <head>  
        <meta charset="utf-8" />  
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />  
        <title>@ViewData["Title"] - Reporteadores</title>
        <link href="~/css/output.css" rel="stylesheet">
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">  
        <!-- Carga jQuery primero -->  
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>  
        <!-- Carga el CSS de DataTables -->  
        <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">  
        <!-- Carga el script de DataTables -->  
        <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>  
    </head>

    <body>
        <header class="fixed top-0 z-50 flex w-full flex-col bg-white py-2 shadow-md lg:flex-row">
            <div class="flex w-full items-center justify-between lg:w-auto lg:flex-grow lg:justify-start">
                <a id="logo"
                    asp-area=""
                    asp-controller="Home"
                    asp-action="Index">
                    <img class="h-10 w-30 py-1 pl-5" src="@Url.Content("~/images/logo.webp")" />
                </a>

                <button id="menu-button"
                        class="block rounded p-2 text-gray-700 hover:bg-blue-100 lg:hidden"
                        onclick="toggleMenu()"
                        aria-label="Menú de navegación">
                    <svg xmlns="http://www.w3.org/2000/svg"
                            class="h-6 w-6"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>

            <nav id="menu" class="hidden w-full flex-grow flex-col lg:flex lg:flex-row lg:space-y-0 lg:space-x-4">
                <div class="flex-grow items-center justify-start lg:flex-row lg:justify-end">
                    <ul class="flex-col justify-end lg:flex lg:flex-row">
                        @if (ViewData["UserActive"] != null)
                        {
                            <li>
                                <a  asp-area=""
                                asp-controller="Home"
                                asp-action="Reporte"
                                class="flex px-2 py-1 text-[15px] hover:rounder hover:scale-105 hover:rounded-lg hover:border-2 hover:bg-blue-500 hover:text-white hover:underline hover:decoration-blue-500 md:inline-block">
                                    Reportes
                                </a>
                            </li>
                            <li>
                                <a  asp-area=""
                                asp-controller="Home"
                                asp-action="Nomina"
                                class="flex px-2 py-1 text-[15px] hover:rounder hover:scale-105 hover:rounded-lg hover:border-2 hover:bg-blue-500 hover:text-white hover:underline hover:decoration-blue-500 md:inline-block">
                                    Nomina
                                </a>
                            </li>
                            
                        }
                        <li>
                            <a asp-area=""
                                asp-controller="Home"
                                asp-action="SoporteReporte"
                                class="flex px-2 py-1 text-[15px] hover:rounder hover:scale-105 hover:rounded-lg hover:border-2 hover:bg-blue-500 hover:text-white hover:underline hover:decoration-blue-500 md:inline-block">
                                Soporte Técnico
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="flex-grow justify-end md:flex">
                    <ul>
                        <li>
                            @if (ViewData["UserActive"] != null)
                            {
                                <a  asp-area=""
                                asp-controller="Home"
                                asp-action="Signout"
                                class="mr-2 inline-block px-2 py-1 text-[15px] hover:scale-105 hover:rounded-lg hover:border-2 hover:bg-red-500 hover:text-white hover:underline hover:decoration-blue-500">
                                    Cerrar Sesión
                                </a>
                            }
                            else
                            {
                                <a asp-area=""
                                    asp-controller="Home"
                                    asp-action="Signout"
                                    class="mr-2 flex px-2 py-1 text-[15px] hover:scale-105 hover:rounded-lg hover:border-2 hover:bg-red-500 hover:text-white hover:underline hover:decoration-blue-500 md:inline-block">
                                    Contacto
                                </a>
                            }
                        </li>
                    </ul>
                </div>
            </nav>
        </header>

            <!-- Script para el menú hamburguesa -->
        <script>
            function toggleMenu() {
            const menu = document.getElementById('menu');
            const menuButton = document.getElementById('menu-button');

            if (menu) {
                // 1. Alterna el estado del menú (mostrar/ocultar)
                menu.classList.toggle('hidden');

                // 2. Si el menú está abierto, añade el detector de clics en el documento.
                // Si está oculto, el detector se habrá eliminado en el paso 3.
                if (!menu.classList.contains('hidden')) {
                    // Añade un retraso para evitar que el clic actual cierre inmediatamente el menú
                    setTimeout(() => {
                        document.addEventListener('click', closeMenuOnOutsideClick);
                    }, 10); // Un pequeño retraso de 10ms es suficiente
                }
            }
        }

        function closeMenuOnOutsideClick(event) {
            const menu = document.getElementById('menu');
            const menuButton = document.getElementById('menu-button');

            // 3. Verifica si el clic ocurrió fuera del menú y fuera del botón de hamburguesa.
            // 'menu.contains(event.target)' verifica si el clic fue dentro del menú.
            // '!menuButton.contains(event.target)' asegura que el clic no fue en el botón de hamburguesa.
            if (menu && !menu.contains(event.target) && !menuButton.contains(event.target)) {
                // Si el clic fue fuera de ambos, oculta el menú y remueve este detector
                menu.classList.add('hidden');
                document.removeEventListener('click', closeMenuOnOutsideClick);
            }
        }

// Opcional: Para evitar que el menú se abra accidentalmente en desktop si el script falla
document.addEventListener('DOMContentLoaded', function() {
    const menu = document.getElementById('menu');
    if (menu) {
        // Asegura que en pantallas grandes (lg), el menú siempre esté visible al cargar la página.
        // Tailwind ya maneja esto con 'lg:flex', pero este es un paso extra de seguridad.
        window.addEventListener('resize', function() {
            if (window.innerWidth >= 1024) { // 1024px es el breakpoint 'lg' de Tailwind
                menu.classList.remove('hidden');
                document.removeEventListener('click', closeMenuOnOutsideClick);
            }
        });
    }
        </script>

        <main role="main">
            @RenderBody()
            <div id="loadingModal" class="bg-opacity-70 fixed inset-0 z-50 hidden bg-black">
                <div class="absolute top-1/2 left-1/2 flex w-full max-w-sm
                    -translate-x-1/2 -translate-y-1/2 transform flex-col items-center justify-center
                    space-y-4 rounded-xl bg-white p-8 shadow-2xl">
                    <p class="text-xl font-bold text-gray-800">Cargando...</p>

                    <div class="h-12 w-12 animate-spin rounded-full border-t-4 border-blue-500"></div>

                    <p class="text-sm text-gray-500">
                        Procesando tu solicitud, esto puede tardar un momento.
                    </p>
                </div>
            </div>
        </main>

        @if (ViewData["UserActive"] == null)
        {
            <footer class="mt-10 bg-[#437cb1] text-center text-white">
                <div class="flex flex-col items-center justify-center space-y-3 p-6 text-center">
                    <img class="h-14 w-14" src="~/images/woman-with-headset.webp" alt="Atención vía telefónica" />
                    <p class="max-w-3xl text-sm md:text-base">
                        La atención vía telefónica está disponible de <b>Lunes a Viernes</b> de <b>9:00 a.m a 2:00 p.m</b> y de <b>4:00 p.m a 6:00 p.m</b>
                        marcando al <b>444-151-85-00 Ext.138</b>, donde atenderemos tus dudas sobre el portal y soporte técnico.
                    </p>
                </div>
                <div class="items-center justify-center bg-black pt-3 text-sm">
                    <p>&copy; 2024 - Reportes ABG | Todos los derechos reservados | GrupoABG</p>
                    <a asp-controller="Home"
                        asp-action="Privacy" 
                        class="text-blue-200 transition-all hover:text-white hover:underline">
                        Aviso de Privacidad
                    </a>
                </div>
            </footer>
        }
    
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        @await RenderSectionAsync("Scripts", required: false)

    </body>

</html>
